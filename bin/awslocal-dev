#!/usr/bin/env bash
# awslocal-dev — minimal `aws` CLI wrapper pointing at LocalStack edge.
# Use this when the `awslocal` pip package is not available.
#
# Env overrides:
#   LOCALSTACK_ENDPOINT  (default: http://localhost:4566)
#   AWS_DEFAULT_REGION   (default: us-east-1)
set -euo pipefail

if ! command -v aws >/dev/null 2>&1; then
  echo "awslocal-dev: 'aws' CLI not found on PATH. Install: https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html" >&2
  exit 127
fi

ENDPOINT="${LOCALSTACK_ENDPOINT:-http://localhost:4566}"
export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-test}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-test}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"
export AWS_ENDPOINT_URL="$ENDPOINT"

exec aws --endpoint-url "$ENDPOINT" "$@"
